{
    "compilerOptions": {
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2024",
        "lib": ["ES2024", "DOM"],
        "types": ["node", "types-mediawiki"],
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "tests/wpvg-assessor/**/*.ts"]
}
